    <!-- 以下配置用于单独指定某一个文件夹下的文件日志级别 -->
    <!-- 这些 logger 的 level 会覆盖 root，且优先级高于 root -->
    <!--    <logger name="com.maple.mapper" level="DEBUG"/>-->
    <!--    <logger name="com.maple.service" level="INFO"/>-->
    <!--    <logger name="com.maple.controller" level="INFO"/>-->

    <!--    <logger name="org.springframework.security" level="DEBUG"/>-->
    <!--    <logger loose="true" name="org.springframework.ai.mcp" level="DEBUG"/>-->
    <!--    <logger name="io.modelcontextprotocol.client" level="DEBUG"/>-->
    <!--    <logger name="io.modelcontextprotocol.spec" level="DEBUG"/>-->

    <!--    <logger name="org.springframework" level="WARN"/>-->
    <!--    <logger name="org.mybatis.spring.mapper" level="ERROR"/>-->
    <!--    <logger name="org.apache.fury" level="WARN"/>-->

        <logger name="org.lixiyun" level="${web.logLevel}"/>

    <!--系统操作日志，info意味：INFO、WARN、ERROR 级别的日志会被处理，DEBUG、TRACE 级别的日志 会被直接丢弃-->
    <!--  项目中所有未单独配置日志级别的类 / 模块，都会继承这个根节点的配置  -->
<!--    <root level="info">-->
    <root level="${log.level.root}">
        <appender-ref ref="console" />
        <appender-ref ref="async_info" />
        <appender-ref ref="async_warn" />
        <appender-ref ref="async_error" />
        <!--        <appender-ref ref="file_console" />-->
        <!--        <appender-ref ref="sky_log"/>-->
    </root>

</configuration>
