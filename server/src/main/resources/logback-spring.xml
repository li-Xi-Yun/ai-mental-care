<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--  定义变量，name为变量名，value为变量值  -->
<!--    <property name="log.path" value="./logs"/>-->
    <!-- 这种使用方式，需要文件名为：logback-spring.xml，从yaml文件中读取配置项 -->
    <!-- scope="context"：变量作用域为整个 Logback 上下文，全局可用 -->
    <!-- name="log.path"：对应该文件后续使用的变量名 -->
    <!-- source="logging.file.path"：对应application.yml中的配置项 -->
    <!-- defaultValue：兜底值，防止配置为空时再次生成_IS_UNDEFINED文件夹 -->
    <springProperty
            scope="context"
            name="log.path"
            source="logging.file.path"
            defaultValue="./logs"
    />
    <!-- 读取 Spring Boot 全局日志级别 -->
    <springProperty
            scope="context"
            name="log.level.root"
            source="logging.level.root"
            defaultValue="INFO"/>
    <!-- 读取开发项目的日志级别 -->
    <springProperty
            scope="context"
            name="web.logLevel"
            source="web.logLevel"
            defaultValue="INFO"/>

    <property name="console.log.pattern"
              value="%red(%d{yyyy-MM-dd HH:mm:ss}) %green([%thread]) %highlight(%-5level) %boldMagenta(%logger{36}%n) - %msg%n"/>
    <property name="log.pattern" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出 -->
    <!--  定义一个名为 console 的 Appender，class="ch.qos.logback.core.ConsoleAppender" 表示使用 Logback 内置的 控制台输出组  -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${console.log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <!-- 有之后的分级日志存储配置，就可以不需要这个统一的日志记录配置了 -->
    <!-- 把 INFO 级别及以上的日志，以纯文本格式写入 ./logs/sys-console.log 文件，并每天生成一个新日志文件，最多保留 30 天的历史日志。 -->
    <!--    <appender name="file_console" class="ch.qos.logback.core.rolling.RollingFileAppender">-->
    <!--        &lt;!&ndash; 当前正在写入的 活动日志文件路径 &ndash;&gt;-->
    <!--        <file>${log.path}/sys-console.log</file>-->
    <!--        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">-->
    <!-- 定义归档日志文件的命名格式，指定 滚动策略为“基于时间”（每天切分一次） -->
    <!--            <fileNamePattern>${log.path}/sys-console.%d{yyyy-MM-dd}.log</fileNamePattern>-->
    <!-- 归档日志最大保留 30 天，不算当天正在写入的活动日志 -->
    <!--            <maxHistory>30</maxHistory>-->
    <!--        </rollingPolicy>-->
    <!--        <encoder>-->
    <!--            &lt;!&ndash; 使用 纯文本日志格式（无颜色） &ndash;&gt;-->
    <!--            <pattern>${log.pattern}</pattern>-->
    <!--            <charset>utf-8</charset>-->
    <!--        </encoder>-->
    <!--        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">-->
    <!--            &lt;!&ndash; 过滤的级别，只记录 INFO 级别及以上的日志（INFO, WARN, ERROR） &ndash;&gt;-->
    <!--            <level>INFO</level>-->
    <!--        </filter>-->
    <!--    </appender>-->

    <!-- 系统日志输出 -->
    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-info.log</file>
        <!-- 自动创建日志目录 -->
        <createOnDemand>true</createOnDemand>
        <!-- 循环政策：基于时间创建日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 定义归档日志文件的命名格式，指定 滚动策略为“基于时间”（每天切分一次），.gz会将自动将文件进行压缩打包 -->
            <fileNamePattern>${log.path}/sys-info.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- 归档日志最大保留 60 天，不算当天正在写入的活动日志 -->
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter"><!-- 使用 LevelFilter（精确级别过滤器） -->
            <!-- 这里只记录日志级别为info的日志 -->
            <!-- 过滤的级别 -->
            <level>INFO</level>
            <!-- 匹配时的操作：接收（记录） -->
            <onMatch>ACCEPT</onMatch>
            <!-- 不匹配时的操作：拒绝（不记录） -->
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 系统日志输出 -->
    <appender name="file_warn" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-warn.log</file>
        <!-- 自动创建日志目录 -->
        <createOnDemand>true</createOnDemand>
        <!-- 循环政策：基于时间创建日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式 -->
            <fileNamePattern>${log.path}/sys-warn.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- 日志最大的历史 60天 -->
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter"><!-- 使用 LevelFilter（精确级别过滤器） -->
            <!-- 这里只记录日志级别为warn的日志 -->
            <!-- 过滤的级别 -->
            <level>WARN</level>
            <!-- 匹配时的操作：接收（记录） -->
            <onMatch>ACCEPT</onMatch>
            <!-- 不匹配时的操作：拒绝（不记录） -->
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-error.log</file>
        <!-- 自动创建日志目录 -->
        <createOnDemand>true</createOnDemand>
        <!-- 循环政策：基于时间创建日志文件 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 日志文件名格式 -->
            <fileNamePattern>${log.path}/sys-error.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- 日志最大的历史 60天 -->
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
            <charset>utf-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <!-- 这里只记录日志级别为 error 的日志 -->
            <!-- 过滤的级别 -->
            <level>ERROR</level>
            <!-- 匹配时的操作：接收（记录） -->
            <onMatch>ACCEPT</onMatch>
            <!-- 不匹配时的操作：拒绝（不记录） -->
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- info异步输出 -->
    <!-- 将 INFO 级别日志的写入操作从主线程“卸载”到后台线程，避免 I/O 阻塞业务逻辑，提升系统性能。 -->
    <appender name="async_info" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>512</queueSize>
        <!-- 添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="file_info"/>
    </appender>

    <!-- warn异步输出 -->
    <appender name="async_warn" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>512</queueSize>
        <!-- 添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="file_warn"/>
    </appender>

    <!-- error异步输出 -->
    <appender name="async_error" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>512</queueSize>
        <!-- 添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="file_error"/>
    </appender>

    <!-- 用于集成 Apache SkyWalking 分布式追踪系统 的日志增强功能。
    它们的作用是在每条日志中自动注入 当前请求的链路追踪 ID（Trace ID），从而实现 日志与调用链的关联。 -->
