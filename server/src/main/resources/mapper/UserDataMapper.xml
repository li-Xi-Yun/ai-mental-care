<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.lixiyun.server.mapper.UserDataMapper">
    <update id="updateUserFileDataVectorCount">
        update user_data set vector_count = vector_count + #{updateNumber}
        <where>
            id in
            <foreach item="item" collection="dataIds" separator="," open="(" close=")">
                #{item}
            </foreach>
        </where>
    </update>
</mapper>